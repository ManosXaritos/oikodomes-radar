# Copy these into Vercel → Project → Settings → Environment Variables.

# Your website address, without a slash at the end (e.g. https://oikodomes-radar.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Shown in the footer, legal pages and sent to OpenStreetMap as contact
NEXT_PUBLIC_CONTACT_EMAIL=
# Shown in the legal pages, e.g. "Επωνυμία, ΑΦΜ 123456789, ΔΟΥ Χ, Οδός 1, Αθήνα"
NEXT_PUBLIC_COMPANY_DETAILS=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=
# Stripe → Product catalog → each price's ID (starts with price_)
STRIPE_PRICE_LOCAL_MONTHLY=
STRIPE_PRICE_LOCAL_YEARLY=
STRIPE_PRICE_REGION_MONTHLY=
STRIPE_PRICE_REGION_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Stripe → Product catalog → Tax rates → your ΦΠΑ 24% rate's ID (starts with txr_)
STRIPE_TAX_RATE_ID=

# Resend → API Keys
RESEND_API_KEY=
# Sender address on a domain you verified in Resend, e.g. "Νέες Οικοδομές Radar <proi@yourdomain.gr>"
EMAIL_FROM=

# Any long random text; protects the daily jobs
CRON_SECRET=
